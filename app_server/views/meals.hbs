<div class="box">
	<div>
		<div class="body">
			<h1>Meals</h1>
			<ul id="foods">
				{{#each meals}}
				<li>
					<h2><a href="/meals">{{name}}</a></h2>
					<div class="infos">
						<a href="/meals"><img src="/images/{{image}}" alt="Img" height="169" width="780"><span class="cover"></span></a>
						<p>
							<span>{{special}}</span> {{description}}
						</p>
					</div>
				</li>
				{{/each}}
			</ul>
		</div>
	</div>
</div>

