<div class="box">
	<div>
		<div id="contact" class="body">
			<h1>Contact</h1>
			<form action="/" method="post">
				<table>
					<tbody>
						<tr>
							<td>Name:</td>
							<td><input type="text" value="" class="txtfield"></td>
						</tr> <tr>
							<td>Email:</td>
							<td><input type="text" value="" class="txtfield"></td>
						</tr> <tr>
							<td>Subject:</td>
							<td><input type="text" value="" class="txtfield"></td>
						</tr> <tr>
							<td class="txtarea">Message:</td>
							<td><textarea></textarea></td>
						</tr> <tr>
							<td></td>
							<td><input type="submit" value="" class="btn"></td>
						</tr>
					</tbody>
				</table>
			</form>
			<h2>{{company.name}}</h2>
			<p>
				<span>Address:</span> {{company.address}}
			</p>
			<p>
				<span>Telephone Number:</span> {{company.telephone}}
			</p>
			<p>
				<span>Fax Number:</span> {{company.fax}}
			</p>
		</div>
	</div>
</div>

