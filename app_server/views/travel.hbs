<div class="box">
	<div>
		<div class="body">
			<h1>Travel</h1>
			{{#if trips}}
			<ul id="sites">
				{{#each trips}}
				<li>
					<img src="/images/{{image}}" alt="Img">
					<h2>{{name}}</h2>
					<p>
						{{description}}
					</p>
					<p>
						<strong>Duration:</strong> {{length}} days | <strong>Starting:</strong> {{startFormatted}} | <strong>Price:</strong> ${{perPerson}} per person
					</p>
				</li>
				{{/each}}
			</ul>
			{{else}}
			<p>No trips available at this time.</p>
			{{/if}}
		</div>
	</div>
</div>
